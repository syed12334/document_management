<!DOCTYPE html>
<html lang="en">
<head>
  <base href="./">
  <meta charset="utf-8">
  <meta name="csrf-token" content="<%= csrfToken %>">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, shrink-to-fit=no">
  <meta name="description" content="Document Management System">
  <title><%= title %></title>

  <!-- Favicons -->
  <link href="assets/favicon/apple-icon-180x180.png" rel="apple-touch-icon" sizes="180x180">
  <link href="assets/favicon/android-icon-192x192.png" rel="icon" sizes="192x192" type="image/png">
  <link href="assets/favicon/favicon-32x32.png" rel="icon" sizes="32x32" type="image/png">
  <link href="assets/favicon/favicon-16x16.png" rel="icon" sizes="16x16" type="image/png">
  <link href="assets/favicon/manifest.json" rel="manifest">
  <meta name="theme-color" content="#ffffff">

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700&display=swap" rel="stylesheet">

  <!-- Vendor styles (kept so existing child views keep working) -->
  <link href="<%= appUrl %>vendors/simplebar/css/simplebar.css" rel="stylesheet">
  <link href="<%= appUrl %>css/vendors/simplebar.css" rel="stylesheet">
  <link href="<%= appUrl %>css/style.css" rel="stylesheet">
  <link href="<%= appUrl %>vendors/@coreui/chartjs/css/coreui-chartjs.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet">

  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
  <script src="<%= appUrl %>js/config.js"></script>
  <script src="<%= appUrl %>js/color-modes.js"></script>

  <style>
    /* ------------------------------------------------------------
       Design tokens
    ------------------------------------------------------------ */
    :root {
      --app-font: 'Figtree', system-ui, -apple-system, 'Segoe UI', sans-serif;

      --bg: #f2f5f8;
      --surface: #ffffff;
      --surface-2: #f7f9fb;
      --line: #e3e8ee;
      --ink: #14202b;
      --ink-soft: #5b6b7a;
      --ink-faint: #8a98a6;

      --brand: #0b7a75;          /* deep teal */
      --brand-strong: #075f5b;
      --brand-tint: #e2f3f1;

      /* Dark sidebar tokens (same in light & dark theme) */
      --sb-bg: #0a1720;
      --sb-line: rgba(255, 255, 255, .07);
      --sb-ink: #93a7b5;
      --sb-ink-strong: #ffffff;
      --sb-hover: rgba(255, 255, 255, .06);
      --sb-active-bg: rgba(60, 196, 187, .14);
      --sb-active-ink: #7ee3db;
      --sb-accent: #3cc4bb;

      --sidebar-w: 260px;
      --sidebar-w-collapsed: 76px;
      --header-h: 64px;
      --radius: 14px;
      --radius-sm: 10px;
      --shadow: 0 1px 2px rgba(20, 32, 43, .05), 0 6px 20px -8px rgba(20, 32, 43, .10);
      --ease: cubic-bezier(.4, 0, .2, 1);
    }

    [data-coreui-theme="dark"] {
      --bg: #0d1419;
      --surface: #141d25;
      --surface-2: #19242e;
      --line: #24323e;
      --ink: #e8eef3;
      --ink-soft: #9fb0be;
      --ink-faint: #6e8090;
      --brand: #3cc4bb;
      --brand-strong: #6ad8d0;
      --brand-tint: #123435;
      --shadow: 0 1px 2px rgba(0, 0, 0, .3), 0 8px 24px -10px rgba(0, 0, 0, .5);
    }

    /* ------------------------------------------------------------
       Base
    ------------------------------------------------------------ */
    body {
      font-family: var(--app-font);
      background: var(--bg);
      color: var(--ink);
      -webkit-font-smoothing: antialiased;
    }

    :focus-visible { outline: 2px solid var(--brand); outline-offset: 2px; }

    /* ------------------------------------------------------------
       Sidebar
    ------------------------------------------------------------ */
    .app-sidebar {
      position: fixed;
      inset: 0 auto 0 0;
      width: var(--sidebar-w);
      background: var(--sb-bg);
      border-right: 1px solid var(--sb-line);
      color: var(--sb-ink);
      display: flex;
      flex-direction: column;
      z-index: 1040;
      transition: width .25s var(--ease), transform .25s var(--ease);
    }

    .app-brand {
      height: var(--header-h);
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 0 20px;
      border-bottom: 1px solid var(--sb-line);
      flex-shrink: 0;
    }
    .app-brand img {
      width: 40px;
      height: 40px;
      padding: 5px;
      object-fit: contain;
      background: #fff;
      border-radius: 11px;
      flex-shrink: 0;
    }
    .app-brand-text { font-weight: 700; font-size: 15px; line-height: 1.15; white-space: nowrap; color: var(--sb-ink-strong); }
    .app-brand-text small { display: block; font-weight: 500; font-size: 12px; color: var(--sb-ink); opacity: .75; }

    .app-nav {
      flex: 1;
      overflow-y: auto;
      padding: 16px 14px;
      list-style: none;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .app-nav-label {
      font-size: 12px;
      font-weight: 600;
      color: var(--sb-ink);
      opacity: .6;
      padding: 16px 12px 6px;
      white-space: nowrap;
    }
    .app-nav::-webkit-scrollbar { width: 6px; }
    .app-nav::-webkit-scrollbar-thumb { background: rgba(255, 255, 255, .12); border-radius: 6px; }

    .app-link {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 10px 12px;
      border-radius: var(--radius-sm);
      color: var(--sb-ink);
      font-weight: 500;
      font-size: 14.5px;
      text-decoration: none;
      white-space: nowrap;
      transition: background .15s, color .15s;
      position: relative;
      width: 100%;
      border: 0;
      background: transparent;
      text-align: left;
      cursor: pointer;
    }
    .app-link i { font-size: 18px; width: 22px; text-align: center; flex-shrink: 0; }
    .app-link:hover { background: var(--sb-hover); color: var(--sb-ink-strong); }
    .app-link.active {
      background: var(--sb-active-bg);
      color: var(--sb-active-ink);
      font-weight: 600;
    }
    .app-link.active i { color: var(--sb-accent); }
    .app-link.active::before {
      content: '';
      position: absolute;
      left: -14px;
      top: 9px;
      bottom: 9px;
      width: 4px;
      border-radius: 0 4px 4px 0;
      background: var(--sb-accent);
      box-shadow: 0 0 12px var(--sb-accent);
    }

    /* Group (Roles & Permissions) */
    .app-group-caret { margin-left: auto; font-size: 12px !important; width: auto !important; transition: transform .2s var(--ease); }
    .app-group.open > .app-link .app-group-caret { transform: rotate(180deg); }
    .app-group-items {
      list-style: none;
      margin: 2px 0 0 22px;
      padding: 0 0 0 10px;
      border-left: 1px solid var(--sb-line);
      display: none;
      flex-direction: column;
      gap: 2px;
    }
    .app-group.open > .app-group-items { display: flex; }
    .app-group-items .app-link { font-size: 14px; padding: 8px 12px; }
    .app-group-items .app-link i { font-size: 16px; }

    /* Sidebar footer */
    .app-sidebar-foot {
      padding: 14px;
      border-top: 1px solid var(--sb-line);
      flex-shrink: 0;
    }
    .app-collapse-btn { display: none; }

    /* Collapsed (desktop) */
    @media (min-width: 992px) {
      .app-collapse-btn { display: flex; }
      body.sidebar-collapsed .app-sidebar { width: var(--sidebar-w-collapsed); }
      body.sidebar-collapsed .app-brand { padding: 0 18px; }
      body.sidebar-collapsed .app-group-items { margin-left: 0; border-left: 0; }
      body.sidebar-collapsed .app-brand-text,
      body.sidebar-collapsed .app-link span,
      body.sidebar-collapsed .app-group-caret,
      body.sidebar-collapsed .app-nav-label { display: none; }
      body.sidebar-collapsed .app-link { justify-content: center; padding: 11px 0; }
      body.sidebar-collapsed .app-group-items { padding-left: 0; }
      body.sidebar-collapsed .app-group.open > .app-group-items { display: flex; }
      body.sidebar-collapsed .app-collapse-btn i { transform: rotate(180deg); }
    }

    /* Mobile drawer */
    .app-backdrop { display: none; }
    @media (max-width: 991.98px) {
      .app-sidebar { transform: translateX(-100%); box-shadow: none; }
      body.sidebar-open .app-sidebar { transform: none; box-shadow: 0 0 40px rgba(0,0,0,.25); }
      body.sidebar-open .app-backdrop {
        display: block;
        position: fixed;
        inset: 0;
        background: rgba(10, 20, 30, .45);
        z-index: 1030;
      }
    }

    /* ------------------------------------------------------------
       Main area
    ------------------------------------------------------------ */
    .app-shell {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      padding-left: var(--sidebar-w);
      transition: padding-left .25s var(--ease);
    }
    body.sidebar-collapsed .app-shell { padding-left: var(--sidebar-w-collapsed); }
    @media (max-width: 991.98px) {
      .app-shell, body.sidebar-collapsed .app-shell { padding-left: 0; }
    }

    .app-header {
      position: sticky;
      top: 0;
      z-index: 1020;
      height: var(--header-h);
      display: flex;
      align-items: center;
      gap: 14px;
      padding: 0 28px;
      background: color-mix(in srgb, var(--surface) 88%, transparent);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      border-bottom: 1px solid var(--line);
    }
    @media (max-width: 575.98px) { .app-header { padding: 0 16px; } }

    .icon-btn {
      width: 40px;
      height: 40px;
      border-radius: var(--radius-sm);
      border: 1px solid transparent;
      background: transparent;
      color: var(--ink-soft);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 19px;
      cursor: pointer;
      transition: background .15s, color .15s;
    }
    .icon-btn:hover { background: var(--surface-2); color: var(--ink); }
    .app-menu-btn { display: none; }
    @media (max-width: 991.98px) { .app-menu-btn { display: inline-flex; } }

    .app-page-title { font-size: 17px; font-weight: 700; margin: 0; letter-spacing: -.01em; }
    .app-header-spacer { flex: 1; }

    /* Dropdowns */
    .app-dropdown {
      border: 1px solid var(--line);
      border-radius: var(--radius-sm);
      background: var(--surface);
      box-shadow: var(--shadow);
      padding: 6px;
      min-width: 180px;
    }
    .app-dropdown .dropdown-item {
      border-radius: 8px;
      font-size: 14px;
      font-weight: 500;
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 8px 10px;
      color: var(--ink-soft);
    }
    .app-dropdown .dropdown-item:hover { background: var(--surface-2); color: var(--ink); }
    .app-dropdown .dropdown-item.active { background: var(--brand-tint); color: var(--brand-strong); }
    .app-dropdown .dropdown-item i { font-size: 16px; }

    .app-avatar {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      padding: 4px 6px 4px 4px;
      border-radius: 999px;
      border: 1px solid var(--line);
      background: var(--surface);
      text-decoration: none;
      color: var(--ink);
      transition: box-shadow .15s;
    }
    .app-avatar:hover { box-shadow: var(--shadow); }
    .app-avatar img { width: 34px; height: 34px; border-radius: 50%; object-fit: cover; }
    .app-avatar i { color: var(--ink-faint); font-size: 12px; margin-right: 4px; }

    /* Content */
    .app-main { flex: 1; padding: 28px; }
    @media (max-width: 575.98px) { .app-main { padding: 16px; } }

    .app-footer {
      padding: 16px 28px;
      font-size: 13px;
      color: var(--ink-faint);
      border-top: 1px solid var(--line);
      display: flex;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 8px;
    }
    .app-footer a { color: var(--ink-soft); text-decoration: none; font-weight: 500; }
    .app-footer a:hover { color: var(--brand); }

    /* ------------------------------------------------------------
       Restyle common child-view components so every page picks up
       the new look without editing each view
    ------------------------------------------------------------ */
    .app-main .card {
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
    }
    .app-main .card-header {
      background: transparent;
      border-bottom: 1px solid var(--line);
      font-weight: 600;
      padding: 16px 20px;
    }
    .app-main .card-body { padding: 20px; }

    .app-main .table { --cui-table-bg: transparent; color: var(--ink); margin-bottom: 0; }
    .app-main .table > :not(caption) > * > * { padding: .85rem 1rem; border-color: var(--line); }
    .app-main .table thead th {
      font-size: 13px;
      font-weight: 600;
      color: var(--ink-soft);
      background: var(--surface-2);
      border-bottom: 1px solid var(--line);
      white-space: nowrap;
    }
    .app-main .table-hover > tbody > tr:hover > * { background: var(--surface-2); }

    .app-main .btn { border-radius: var(--radius-sm); font-weight: 600; font-size: 14px; padding: 8px 16px; }
    .app-main .btn-sm { padding: 5px 11px; font-size: 13px; border-radius: 8px; }
    .app-main .btn-primary { background: var(--brand); border-color: var(--brand); color: #fff; }
    .app-main .btn-primary:hover,
    .app-main .btn-primary:focus { background: var(--brand-strong); border-color: var(--brand-strong); color: #fff; }
    .app-main .btn-outline-primary { color: var(--brand); border-color: var(--brand); }
    .app-main .btn-outline-primary:hover { background: var(--brand); border-color: var(--brand); color: #fff; }

    .app-main .form-control,
    .app-main .form-select {
      border-radius: var(--radius-sm);
      border: 1px solid var(--line);
      background-color: var(--surface);
      color: var(--ink);
      padding: 9px 12px;
    }
    .app-main .form-control:focus,
    .app-main .form-select:focus {
      border-color: var(--brand);
      box-shadow: 0 0 0 3px color-mix(in srgb, var(--brand) 20%, transparent);
    }
    .app-main .form-label { font-weight: 600; font-size: 14px; color: var(--ink); }

    .app-main .modal-content { border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); }
    .app-main .modal-header, .modal-header { border-bottom: 1px solid var(--line); }
    .modal-footer { border-top: 1px solid var(--line); }
    .modal-content { border-radius: var(--radius); }

    .app-main .badge { border-radius: 999px; font-weight: 600; padding: .4em .75em; }
    .app-main .page-link { border-radius: 8px; margin: 0 2px; color: var(--ink-soft); border-color: var(--line); }
    .app-main .page-item.active .page-link { background: var(--brand); border-color: var(--brand); color: #fff; }

    /* Select2 */
    .select2-container--bootstrap-5 .select2-selection { border-radius: var(--radius-sm); border-color: var(--line); min-height: 40px; }
    .select2-container--bootstrap-5.select2-container--focus .select2-selection,
    .select2-container--bootstrap-5.select2-container--open .select2-selection {
      border-color: var(--brand);
      box-shadow: 0 0 0 3px color-mix(in srgb, var(--brand) 20%, transparent);
    }

    /* ------------------------------------------------------------
       Folder / file tree table (used by the Folders page)
    ------------------------------------------------------------ */
    .folder-table { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; }
    .folder-row { cursor: pointer; transition: background .15s; }
    .folder-row:hover { background: var(--surface-2); }
    .folder-icon { color: #e0a100; font-size: 20px; }
    .file-icon { color: var(--ink-faint); font-size: 18px; }
    .toggle-btn { border: 0; background: transparent; padding: 0; margin-right: 8px; width: 20px; color: var(--ink-soft); }
    .folder-name { font-weight: 600; }
    .nested { display: none; }
    .nested.show { display: table-row; }
    .indent-1 { padding-left: 45px !important; }
    .indent-2 { padding-left: 80px !important; }
    .indent-3 { padding-left: 115px !important; }
    .file-row { background: var(--surface-2); }

    /* Respect reduced motion */
    @media (prefers-reduced-motion: reduce) {
      * { transition: none !important; }
    }
  </style>
</head>

<body>
  <!-- ============================ SIDEBAR ============================ -->
  <aside class="app-sidebar" id="sidebar" aria-label="Main navigation">
    <div class="app-brand">
      <img src="<%= appUrl %>assets/img/logo.png" alt="Logo">
      <div class="app-brand-text">
        Document<br>Management
        <small>Workspace</small>
      </div>
    </div>

    <ul class="app-nav" data-simplebar>
      <li class="app-nav-label">Library</li>

      <% if (hasPermission('view-folder')) { %>
      <li>
        <a class="app-link" href="<%= appUrl %>folders/" title="Folders">
          <i class="bi bi-folder2"></i><span>Folders</span>
        </a>
      </li>
      <% } %>

      <% if (hasPermission('view-document')) { %>
      <li>
        <a class="app-link" href="<%= appUrl %>documents" title="Documents">
          <i class="bi bi-file-earmark-text"></i><span>Documents</span>
        </a>
      </li>
      <% } %>

      <% if (hasPermission('view-user') || (hasPermission('view-role') && hasPermission('view-permission'))) { %>
      <li class="app-nav-label">Access</li>
      <% } %>

      <% if (hasPermission('view-user')) { %>
      <li>
        <a class="app-link" href="<%= appUrl %>users" title="Users">
          <i class="bi bi-people"></i><span>Users</span>
        </a>
      </li>
      <% } %>

      <% if (hasPermission('view-role') && hasPermission('view-permission')) { %>
      <li class="app-group">
        <button class="app-link" type="button" data-group-toggle title="Roles &amp; Permissions" aria-expanded="false">
          <i class="bi bi-shield-lock"></i><span>Roles &amp; Permissions</span>
          <i class="bi bi-chevron-down app-group-caret"></i>
        </button>
        <ul class="app-group-items">
          <% if (hasPermission('view-role')) { %>
          <li>
            <a class="app-link" href="<%= appUrl %>roles" title="Roles">
              <i class="bi bi-person-badge"></i><span>Roles</span>
            </a>
          </li>
          <% } %>
          <% if (hasPermission('view-permission')) { %>
          <li>
            <a class="app-link" href="<%= appUrl %>permissions" title="Permissions">
              <i class="bi bi-key"></i><span>Permissions</span>
            </a>
          </li>
          <% } %>
          <!-- <li>
            <a class="app-link" href="<%= appUrl %>role/permission" target="_top" title="Assign permission">
              <i class="bi bi-diagram-3"></i><span>Assign permission</span>
            </a>
          </li> -->
        </ul>
      </li>
      <% } %>

      <% if (hasPermission('view-audit-logs') || hasPermission('view-user-history')) { %>
      <li class="app-nav-label">Activity</li>
      <% } %>

      <% if (hasPermission('view-audit-logs')) { %>
      <li>
        <a class="app-link" href="<%= appUrl %>audit/logs" title="Audit logs">
          <i class="bi bi-clipboard-data"></i><span>Audit logs</span>
        </a>
      </li>
      <% } %>

      <% if (hasPermission('view-user-history')) { %>
      <li>
        <a class="app-link" href="<%= appUrl %>user/login/logs" title="User login history">
          <i class="bi bi-clock-history"></i><span>User login history</span>
        </a>
      </li>
      <% } %>
    </ul>

    <div class="app-sidebar-foot">
      <button class="app-link app-collapse-btn" type="button" id="collapseBtn" title="Collapse sidebar">
        <i class="bi bi-chevron-double-left"></i><span>Collapse</span>
      </button>
    </div>
  </aside>
  <div class="app-backdrop" id="backdrop"></div>

  <!-- ============================== MAIN ============================== -->
  <div class="app-shell">
    <header class="app-header">
      <button class="icon-btn app-menu-btn" type="button" id="menuBtn" aria-label="Open menu">
        <i class="bi bi-list"></i>
      </button>
      <h1 class="app-page-title"><%= title %></h1>

      <div class="app-header-spacer"></div>

      <!-- Theme switcher -->
      <div class="dropdown">
        <button class="icon-btn" type="button" data-coreui-toggle="dropdown" aria-expanded="false" aria-label="Change theme">
          <i class="bi bi-circle-half"></i>
        </button>
        <ul class="dropdown-menu dropdown-menu-end app-dropdown">
          <li><button class="dropdown-item" data-coreui-theme-value="light" type="button"><i class="bi bi-sun"></i> Light</button></li>
          <li><button class="dropdown-item" data-coreui-theme-value="dark" type="button"><i class="bi bi-moon-stars"></i> Dark</button></li>
          <li><button class="dropdown-item active" data-coreui-theme-value="auto" type="button"><i class="bi bi-circle-half"></i> Auto</button></li>
        </ul>
      </div>

      <!-- User menu -->
      <div class="dropdown">
        <a class="app-avatar" href="#" role="button" data-coreui-toggle="dropdown" aria-expanded="false" aria-haspopup="true">
          <img src="<%= appUrl %>assets/img/avatars/8.jpg" alt="Account">
          <i class="bi bi-chevron-down"></i>
        </a>
        <div class="dropdown-menu dropdown-menu-end app-dropdown">
          <a class="dropdown-item" href="/login/logout"><i class="bi bi-box-arrow-right"></i> Log out</a>
        </div>
      </div>
    </header>

    <main class="app-main">
      <%- body %>
    </main>

    <footer class="app-footer">
      <span>&copy; <script>document.write(new Date().getFullYear())</script> Document Management System</span>
      <a href="https://coreui.io/bootstrap/docs/">Powered by CoreUI</a>
    </footer>
  </div>

  <!-- ============================ SCRIPTS ============================ -->
  <script src="<%= appUrl %>vendors/@coreui/coreui/js/coreui.bundle.min.js"></script>
  <script src="<%= appUrl %>vendors/simplebar/js/simplebar.min.js"></script>
  <script src="<%= appUrl %>vendors/chart.js/js/chart.umd.js"></script>
  <script src="<%= appUrl %>vendors/@coreui/chartjs/js/coreui-chartjs.js"></script>
  <script src="<%= appUrl %>vendors/@coreui/utils/js/index.js"></script>
  <script src="<%= appUrl %>js/main.js"></script>

  <script>
    (function () {
      var body = document.body;
      var KEY = 'dms-sidebar-collapsed';

      // Restore collapsed state (desktop)
      try { if (localStorage.getItem(KEY) === '1') body.classList.add('sidebar-collapsed'); } catch (e) {}

      // Desktop collapse
      var collapseBtn = document.getElementById('collapseBtn');
      if (collapseBtn) {
        collapseBtn.addEventListener('click', function () {
          var collapsed = body.classList.toggle('sidebar-collapsed');
          try { localStorage.setItem(KEY, collapsed ? '1' : '0'); } catch (e) {}
        });
      }

      // Mobile drawer
      document.getElementById('menuBtn').addEventListener('click', function () {
        body.classList.toggle('sidebar-open');
      });
      document.getElementById('backdrop').addEventListener('click', function () {
        body.classList.remove('sidebar-open');
      });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') body.classList.remove('sidebar-open');
      });

      // Collapsible groups
      document.querySelectorAll('[data-group-toggle]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var group = btn.closest('.app-group');
          var open = group.classList.toggle('open');
          btn.setAttribute('aria-expanded', open);
        });
      });

      // Active link highlighting
      document.addEventListener('DOMContentLoaded', function () {
        var currentPath = window.location.pathname.replace(/\/+$/, '') || '/';

        document.querySelectorAll('.app-nav a.app-link').forEach(function (link) {
          var linkPath = new URL(link.href, window.location.origin).pathname.replace(/\/+$/, '') || '/';
          var isActive = linkPath === currentPath ||
            (linkPath !== '/' && currentPath.indexOf(linkPath + '/') === 0);

          link.classList.toggle('active', isActive);

          if (isActive) {
            var group = link.closest('.app-group');
            if (group) {
              group.classList.add('open');
              group.querySelector('[data-group-toggle]').setAttribute('aria-expanded', 'true');
            }
          }
        });

        // Scroll header shadow
        var header = document.querySelector('.app-header');
        document.addEventListener('scroll', function () {
          header.classList.toggle('shadow-sm', document.documentElement.scrollTop > 0);
        });
      });
    })();
  </script>

  <!-- Select2 -->
  <script>
    function initSelect2(root) {
      $(root || document).find('select:not(.no-select2)').each(function () {
        var $el = $(this);
        if ($el.hasClass('select2-hidden-accessible')) return; // already initialised

        var $modal = $el.closest('.modal');
        $el.select2({
          theme: 'bootstrap-5',
          width: '100%',
          dropdownParent: $modal.length ? $modal : $(document.body)
        });
      });
    }

    $(function () { initSelect2(); });
  </script>
</body>
</html>
